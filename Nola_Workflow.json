      "parameters": {
        "jsCode": "const rawAnswer = $input.first().json.choices[0].message.content;\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nconst userMessage = $('Telegram Trigger').first().json.message.text;\n\nconst answer = rawAnswer\n  .replace(/\\*\\*/g, '')\n  .replace(/\\*/g, '')\n  .replace(/_{1,2}/g, '')\n  .replace(/#{1,6} /g, '');\n\nconst isFallback = /não encontrei|nao encontrei|entrar em contato/i.test(answer);\n\nreturn [{ json: { answer, chatId, userMessage, isFallback } }];"
      },
